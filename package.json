{
  "activationEvents": [
    "onStartupFinished",
    "onCommand:glyphMark.refresh",
    "onCommand:glyphMark.manageMarks"
  ],
  "bugs": {
    "url": "https://github.com/masanori-satake/GlyphMark-Solo/issues"
  },
  "categories": [
    "Other"
  ],
  "contributes": {
    "commands": [
      {
        "command": "glyphMark.manageMarks",
        "category": "GlyphMark",
        "icon": "$(symbol-character)",
        "title": "%command.manageMarks.title%"
      },
      {
        "command": "glyphMark.refresh",
        "category": "GlyphMark",
        "icon": "$(refresh)",
        "title": "%command.refresh.title%"
      }
    ],
    "configuration": {
      "properties": {
        "glyphMark.folderBadges": {
          "default": true,
          "description": "%config.folderBadges.description%",
          "type": "boolean"
        },
        "glyphMark.marks": {
          "default": [],
          "description": "%config.marks.description%",
          "items": {
            "additionalProperties": false,
            "properties": {
              "days": {
                "maximum": 36500,
                "minimum": 1,
                "type": "number"
              },
              "glyph": {
                "maxLength": 2,
                "minLength": 1,
                "pattern": "^[^\\u0000-\\u0020\\u007f-\\u00a0\\u00ad\\u061c\\u180e\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u2064\\ufe00-\\ufe0f\\ufeff]+$",
                "type": "string"
              },
              "item": {
                "enum": [
                  "createdRecent",
                  "updatedRecent",
                  "updatedFrequently",
                  "untouchedLong",
                  "lastAuthorMe",
                  "lastAuthorNamed",
                  "nameContains",
                  "pathContains",
                  "sizeLarge"
                ],
                "type": "string"
              },
              "kb": {
                "maximum": 1048576,
                "minimum": 1,
                "type": "number"
              },
              "label": {
                "maxLength": 100,
                "type": "string"
              },
              "minCount": {
                "maximum": 10000,
                "minimum": 1,
                "type": "number"
              },
              "text": {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "item",
              "glyph"
            ],
            "type": "object"
          },
          "maxItems": 200,
          "type": "array"
        },
        "glyphMark.paletteStyle": {
          "default": "symbol",
          "description": "%config.paletteStyle.description%",
          "enum": [
            "symbol",
            "emoji"
          ],
          "enumDescriptions": [
            "%config.paletteStyle.symbol%",
            "%config.paletteStyle.emoji%"
          ],
          "type": "string"
        }
      },
      "title": "%config.title%"
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "description": "In Restricted Mode the extension does not run git in the workspace and ignores workspace-folder values of glyphMark.marks; marks from user settings and file times/sizes still work.",
      "restrictedConfigurations": [
        "glyphMark.marks"
      ],
      "supported": "limited"
    },
    "virtualWorkspaces": {
      "description": "GlyphMark reads local git history and file stats, so it does not run in virtual workspaces.",
      "supported": false
    }
  },
  "description": "%extension.description%",
  "displayName": "GlyphMark-Solo",
  "engines": {
    "vscode": "^1.90.0"
  },
  "homepage": "https://github.com/masanori-satake/GlyphMark-Solo#readme",
  "icon": "icon.png",
  "keywords": [
    "explorer",
    "badge",
    "glyph",
    "decoration",
    "git"
  ],
  "license": "MIT",
  "main": "./src/extension.js",
  "name": "glyphmark-solo",
  "publisher": "masanori-satake",
  "repository": {
    "type": "git",
    "url": "https://github.com/masanori-satake/GlyphMark-Solo"
  },
  "scripts": {
    "check": "node --check src/extension.js && node --check src/core.js && node --check media/manager.js",
    "check-version": "node scripts/check-version.js",
    "check-version-bump": "node scripts/check-version.js --check-bump",
    "package": "npm run check-version && npx @vscode/vsce package",
    "test": "node --test test/*.test.js",
    "update-version": "node scripts/update-version.js",
    "vscode:prepublish": "npm run check && npm test"
  },
  "version": "1.1.3"
}
